// hk (https://hk.jdx.dev) — git hooks and the `hk check --all` aggregate used by `mise run check`.
// Tool versions are pinned in mise.toml. Three tiers:
//   pre-commit  : these steps on staged files (fast ones in seconds; the Gradle steps only when
//                 Java or build files are staged, ~5-20 s with the daemon warm)
//   hk check    : the same steps on changed files
//   mise run check : `hk check --all` + rule tests + full history secret scan (the gate)
amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

steps {
    // --- secrets -------------------------------------------------------------------------
    ["betterleaks"] = Builtins.betterleaks

    // --- file hygiene --------------------------------------------------------------------
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["newlines"] = Builtins.newlines
    ["check_merge_conflict"] = Builtins.check_merge_conflict
    ["check_added_large_files"] = Builtins.check_added_large_files
    // JSON validity only (nvidium.mixins.json, lang files). Builtins.jq would also enforce jq's
    // key-sorted layout on the resource files, which is not our job.
    ["json"] {
        glob = List("**/*.json")
        check = "jq -e . {{files}} > /dev/null"
    }

    // --- text ----------------------------------------------------------------------------
    // typos: check only. Its autofix renames identifiers, which must be reviewed (and in GLSL
    // kept consistent across files), so run `typos -w` by hand and read the diff.
    ["typos"] = (Builtins.typos) {
        fix = null
    }
    ["rumdl"] = Builtins.rumdl

    // --- bench/ helper scripts -----------------------------------------------------------
    ["shellcheck"] = Builtins.shellcheck
    ["ruff"] = Builtins.ruff
    ["ruff_format"] = Builtins.ruff_format

    // --- project rules (rules/*.yml) -----------------------------------------------------
    ["ast-grep"] {
        glob = List("src/main/java/**/*.java")
        check = "ast-grep scan {{files}}"
    }

    // --- Vulkan shaders: glslc (system package `shaderc`) compiles every vk/ entry shader -----------
    ["vk-shaders"] {
        glob = List("src/main/resources/assets/nvidium/shaders/**", "bench/compile-vk-shaders.py")
        check = "python3 -I bench/compile-vk-shaders.py"
    }

    // --- Java: Spotless (palantir-java-format) and Error Prone via Gradle --------------
    // `--daemon` overrides org.gradle.daemon=false from gradle.properties (kept false for the
    // benchmark runs); a warm daemon makes the incremental compile take seconds.
    ["spotless"] {
        glob = List("src/**/*.java")
        check = "./gradlew --daemon -q spotlessCheck"
        fix = "./gradlew --daemon -q spotlessApply"
        stage = List("src/**/*.java")
        exclusive = true
    }
    ["errorprone"] {
        glob = List("src/**/*.java", "*.gradle", "gradle.properties", "gradle/**")
        check = "./gradlew --daemon -q compileJava compileDevJava"
        depends = List("spotless")
        exclusive = true
    }
}
